<?xml version="1.0" encoding="UTF-8"?>
<!--
    The documented workflow on a reactor with nothing to report (every dependency is
    ignored). The build must succeed: the new failure paths must not fire when the reactor
    really is clean.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.apitomy.it</groupId>
    <artifactId>report-all-aligned</artifactId>
    <version>1.0.0-redhat-00001</version>
    <packaging>pom</packaging>

    <modules>
        <module>mod-a</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>io.apitomy</groupId>
                <artifactId>apitomy-maven-plugin</artifactId>
                <version>@project.version@</version>
                <executions>
                    <execution>
                        <id>verify-deps</id>
                        <goals>
                            <goal>verify-project-dependencies</goal>
                        </goals>
                        <configuration>
                            <ignoreGAVs>
                                <ignoreGAV>*:*</ignoreGAV>
                            </ignoreGAVs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
